---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import SectionContainer from '../components/SectionContainer.astro'
import Experience from '../components/Experience.astro';
import GitHubIcon  from '../components/icons/GitHub.astro';
import DiscordIcon from '../components/icons/DiscordIcon.astro'
import DownloadIcon from '../components/icons/Download.astro'
import SocialPill from '../components/SocialPill.astro';
import BriefcaseIcon from '../components/icons/BriefcaseIcon.astro';
import CodeIcon from '../components/icons/codeIcon.astro';
import User from '../components/icons/UserIcon.astro'
import AboutMe from '../components/AboutMe.astro';
import ArnabalIcon from '../../public/arnabal.png'

---

<Layout title="Portfolio de Arnabal - Desarrollador y Programador Web"	 description="Portfolio oficial de Arnabal , programador web con más de 4 años de experencia. Especializado en crear aplicaciones únicas.">
	<main class="px-4">
		<SectionContainer class ="py-44 pb-32">
		<img class="rounded-full size-12 mb-4" src={ArnabalIcon.src} alt="arnabal photo" />
		<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold  flex flex-row gap-x-4 pb-6 lg:pb-10">
			Hey, soy Arnabal <div class="flex justify-center items-center"><Badge>Disponible para trabajar</Badge></div></h1>
		<h2 class="text-xl lg:text-2xl opacity-80 text-wrap max-w-[700px]">
			+6 años de experencia desarrollando <span class="text-yellow-200">aplicaciones web</span> por mi cuenta, de Granada , España 🇪🇸.
			Apasionado por el <span class="text-yellow-200">desarrollo</span>, la <span class="text-yellow-200">investigación</span> y la <span class="text-yellow-200">innovación</span>.
		</h2>
		<nav class="flex gap-x-4 mt-8">
		
				<SocialPill href="https://github.com/Arnaball">
					<GitHubIcon class="size-4 md:size-6"/>
					GitHub
				</SocialPill> 
				
				<SocialPill href="public/cv/alejandro_cv.pdf">
					<DownloadIcon class="size-4 md:size-6"/>
					Descargar Curriculum
				</SocialPill> 
		
		
				


			
		</nav>
		</SectionContainer>
		<div class="space-y-24">
		<SectionContainer id ="experiencia">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<BriefcaseIcon class="size-7" />
				Experiencia
			</h2>
			<Experience />
		</SectionContainer>

		<SectionContainer id ="proyectos">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size-7" />
				Proyectos
			</h2>
			<Projects />
		</SectionContainer>

		<SectionContainer id ="sobre-mi">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<User class="size-7"/>
				Sobre mí
				
			</h2>
			<AboutMe />
		</SectionContainer>
		</div>
	</main>
</Layout>


