---
const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:arnabaldeveloper@gmail.com",
  },
]
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2">
  <nav class="flex px-3 text-sm font-medium rounded-full text-gray-200 bg-gray-800 justify-center items-center">
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-blue-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const initObserver = () => {
    console.log('INIT Observer')
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries:any[]) => {
      entries.forEach((entry) => {
        console.log(`Sección observada: ${entry.target.id}, Intersectando: ${entry.isIntersecting}`);

        if (entry.isIntersecting) {
          console.log(`⚡ La sección ${entry.target.id} está visible en el viewport`);

          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") === entry.target.id) {
              item.classList.add("text-blue-500");
              console.log(`🔵 Activando enlace para sección: ${entry.target.id}`);
            } else {
              item.classList.remove("text-blue-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  }

  // Usar window.onload para llamar la función cuando la página haya cargado completamente
  window.onload = initObserver

  // Si usas viewTransitions esto se ejecutara solo 1 vez, por cada vez que recargues la página
  // document.addEventListener("astro:page-load", initObserver)
  // Este handler se ejecutará cada vez que hagas una navegación interna
  // document.addEventListener("astro:after-swap", initObserver)
</script>


<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply bg-gray-800 text-gray-200;
  }

  @keyframes nav-shadow {
    0% {
      @apply bg-gray-800/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
